{
  "name": "treelife-drive",
  "version": "1.0.0",
  "description": "Treelife Drive desktop sync client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "electron-store": "^8.2.0",
    "keytar": "^7.9.0",
    "node-fetch": "^2.7.0",
    "form-data": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "co.treelife.drive",
    "productName": "Treelife Drive",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "TrelifeDriveSetup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "installerHeaderIcon": "assets/icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "assets/**",
      "!native/**/*.cc",
      "!native/**/*.h"
    ],
    "publish": null,
    "protocols": [
      {
        "name": "Treelife Drive",
        "schemes": [
          "treelife"
        ]
      }
    ]
  }
}